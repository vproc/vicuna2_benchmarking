diff --git a/runtime/src/iree/base/alignment.h b/runtime/src/iree/base/alignment.h
index 49a8798604..a396daa8af 100644
--- a/runtime/src/iree/base/alignment.h
+++ b/runtime/src/iree/base/alignment.h
@@ -132,9 +132,9 @@ static inline iree_host_size_t iree_host_size_next_power_of_two(
   value |= value >> 4;
   value |= value >> 8;
   value |= value >> 16;
-  if (sizeof(iree_host_size_t) == 8) {
-    value |= value >> 32;
-  }
+#if defined(IREE_PTR_SIZE_64)
