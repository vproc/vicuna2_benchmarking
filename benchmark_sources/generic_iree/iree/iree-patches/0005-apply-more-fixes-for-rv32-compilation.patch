+#endif  // IREE_PTR_SIZE_64
   return value + 1;
 }
 
@@ -180,9 +180,9 @@ static inline iree_device_size_t iree_device_size_next_power_of_two(
   value |= value >> 4;
   value |= value >> 8;
   value |= value >> 16;
-  if (sizeof(iree_device_size_t) == 8) {
-    value |= value >> 32;
-  }
+#if defined(IREE_PTR_SIZE_64)
+  value |= value >> 32;
+#endif  // IREE_PTR_SIZE_64
   return value + 1;
 }
 
