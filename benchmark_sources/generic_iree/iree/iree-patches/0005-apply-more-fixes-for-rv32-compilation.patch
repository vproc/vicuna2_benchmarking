From: Muhammed Efe Cetin <efectn@protonmail.com>
Date: Thu, 16 Jul 2026 16:21:54 +0200
Subject: [PATCH 5/5] apply more fixes for rv32 compilation

---
 riscv32_generic.cmake                         | 37 +++++++++++++++++++
 runtime/src/iree/async/CMakeLists.txt         |  2 +-
 .../async/platform/posix/cts/CMakeLists.txt   |  2 +-
 runtime/src/iree/async/socket.c               |  6 ++-
 runtime/src/iree/base/alignment.h             | 12 +++---
 runtime/src/iree/base/string_view.c           |  4 +-
 runtime/src/iree/base/time.c                  |  7 ++++
 runtime/src/iree/hal/string_util.c            |  5 ++-
 runtime/src/iree/modules/vmvx/module.c        |  6 +--
 9 files changed, 65 insertions(+), 16 deletions(-)
 create mode 100644 riscv32_generic.cmake

diff --git a/riscv32_generic.cmake b/riscv32_generic.cmake
new file mode 100644
index 0000000000..90c31f339b
--- /dev/null
+++ b/riscv32_generic.cmake
@@ -0,0 +1,37 @@
+set(CMAKE_SYSTEM_PROCESSOR riscv32)
+
+# Build the IREE runtime only
+set(IREE_BUILD_COMPILER OFF)
+
+# Tell CMake to skip targeting a specific operating system
+set(CMAKE_SYSTEM_NAME Generic)
+
+set(IREE_ENABLE_THREADING OFF)
+set(IREE_SYNCHRONIZATION_DISABLE_UNSAFE ON)
+set(IREE_HAL_DRIVER_DEFAULTS OFF)
+set(IREE_HAL_DRIVER_LOCAL_SYNC ON)
+set(IREE_HAL_EXECUTABLE_LOADER_DEFAULTS OFF)
+set(IREE_HAL_EXECUTABLE_LOADER_EMBEDDED_ELF ON)
+set(IREE_HAL_EXECUTABLE_LOADER_VMVX_MODULE ON)
+set(IREE_HAL_EXECUTABLE_PLUGIN_DEFAULTS OFF)
+set(IREE_HAL_EXECUTABLE_PLUGIN_EMBEDDED_ELF ON)
+set(IREE_BUILD_TESTS OFF)
+set(IREE_BUILD_SAMPLES OFF)
+# set(IREE_ENABLE_POSIX OFF CACHE BOOL "" FORCE)
+set(IREE_HAL_DRIVER_LOCAL_TASK OFF CACHE BOOL "" FORCE)
+# set(CMAKE_C_EXTENSIONS OFF CACHE BOOL "" FORCE) # runtime/src/iree/base/time.c:108:13: error: call to undeclared function 'clock_nanosleep'
+set(IREE_HAL_EXECUTABLE_LOADER_SYSTEM_LIBRARY OFF CACHE BOOL "" FORCE)
+set(IREE_HAL_EXECUTABLE_PLUGIN_SYSTEM_LIBRARY OFF CACHE BOOL "" FORCE)
+set(IREE_BUILD_BINDINGS_TFLITE ON)
+
+set(TOOLCHAIN_PREFIX "riscv64-unknown-elf-")
+set(CMAKE_C_COMPILER ${TOOLCHAIN_PREFIX}gcc)
+set(CMAKE_CXX_COMPILER ${TOOLCHAIN_PREFIX}g++)
+
+set(RISCV_FLAGS "-march=rv32imacv_zicsr_zifencei_zba_zbb_zbc_zbs -mabi=ilp32")
+
+set(CMAKE_C_FLAGS "${RISCV_FLAGS} -DIREE_CSPRNG_USE_STUB -DIREE_DEVICE_SIZE_T=uint32_t -DPRIdsz=PRIu32 -DIREE_SOCKETS_ENABLE=0 -DIREE_PLATFORM_GENERIC=1 -DIREE_FILE_IO_ENABLE=0 -DIREE_TIME_NOW_FN=\"{ return 0; }\" -DIREE_WAIT_UNTIL_FN=my_wait_until -Wno-format" CACHE STRING "")
+set(CMAKE_CXX_FLAGS "${RISCV_FLAGS} -DIREE_CSPRNG_USE_STUB -DIREE_DEVICE_SIZE_T=uint32_t -DPRIdsz=PRIu32 -DIREE_SOCKETS_ENABLE=0 -DIREE_PLATFORM_GENERIC=1 -DIREE_FILE_IO_ENABLE=0 -DIREE_TIME_NOW_FN=\"{ return 0; }\" -DIREE_WAIT_UNTIL_FN=my_wait_until -Wno-format" CACHE STRING "")
+
+
+set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
\ No newline at end of file
diff --git a/runtime/src/iree/async/CMakeLists.txt b/runtime/src/iree/async/CMakeLists.txt
index 1211e7c415..95ec5fae45 100644
--- a/runtime/src/iree/async/CMakeLists.txt
+++ b/runtime/src/iree/async/CMakeLists.txt
@@ -102,7 +102,7 @@ elseif(CMAKE_SYSTEM_NAME STREQUAL "Windows")
   list(APPEND _platform_platform_deps iree::async::platform::iocp)
 elseif(IREE_ARCH STREQUAL "wasm_32")
   list(APPEND _platform_platform_deps iree::async::platform::js::proactor)
-else()
+elseif(NOT CMAKE_SYSTEM_NAME STREQUAL "Generic")
   list(APPEND _platform_platform_deps iree::async::platform::posix)
 endif()
 iree_cc_library(
