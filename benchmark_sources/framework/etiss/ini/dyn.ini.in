[Plugin PerformanceEstimatorPlugin]
plugin.perfEst.uArch=Vicuna_zvl@VREG_W@b
plugin.perfEst.print=1
[Plugin TracePrinterPlugin]
plugin.tracePrinter.trace=AssemblyTrace
plugin.tracePrinter.stream.toFile=1
plugin.tracePrinter.stream.fileName=asm_trace
plugin.tracePrinter.stream.rotateSize=0x10000
plugin.tracePrinter.stream.outDir=@TEST_TRACE_DIR@
plugin.perfEst.printDir=@TEST_TRACE_DIR@